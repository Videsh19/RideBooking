# ==============================================================================
# GoRide Server Environment Variables
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
# NOTE: Schema will be derived from approved UML class diagram in Phase 2.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=goride_db
DB_CONNECTION_LIMIT=10

# Routing & Geocoding Service Configuration
# Driving road distance & duration provider endpoint
ROUTING_API_URL=https://router.project-osrm.org
# Location autocomplete and geocoding provider endpoint
GEOCODING_API_URL=https://photon.komoot.io/api

# Authentication & Security
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d
# Required in production for administrator account seeding/bootstrap.
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_random_password
